# Managed by server-bootstrap. Do not edit manually.
*filter
:{{ firewall_chain_name }} - [0:0]
-A {{ firewall_chain_name }} -p ipv6-icmp --icmpv6-type echo-request -j ACCEPT
-A {{ firewall_chain_name }} -p ipv6-icmp --icmpv6-type destination-unreachable -j ACCEPT
-A {{ firewall_chain_name }} -p ipv6-icmp --icmpv6-type packet-too-big -j ACCEPT
-A {{ firewall_chain_name }} -p ipv6-icmp --icmpv6-type time-exceeded -j ACCEPT
-A {{ firewall_chain_name }} -p ipv6-icmp --icmpv6-type neighbor-solicitation -j ACCEPT
-A {{ firewall_chain_name }} -p ipv6-icmp --icmpv6-type neighbor-advertisement -j ACCEPT
{% for port in firewall_allowed_tcp_ports_effective %}
-A {{ firewall_chain_name }} -p tcp -m tcp --dport {{ port }} -j ACCEPT
{% endfor %}
{% for port in firewall_allowed_udp_ports_effective %}
-A {{ firewall_chain_name }} -p udp -m udp --dport {{ port }} -j ACCEPT
{% endfor %}
-A {{ firewall_chain_name }} -j RETURN
COMMIT
