#!/bin/sh
set -eu

IPT="/usr/sbin/ip6tables"
CHAIN="{{ firewall_chain_name }}"
COMMENT="{{ firewall_jump_comment }}"
FRAGMENT="{{ firewall_rules_fragment_v6 }}"

[ -f "$FRAGMENT" ] || exit 0

"$IPT" -N "$CHAIN" 2>/dev/null || true
while "$IPT" -D INPUT -m comment --comment "$COMMENT" -j "$CHAIN" 2>/dev/null; do :; done
"$IPT" -F "$CHAIN"

"$IPT" -C INPUT -i lo -j ACCEPT 2>/dev/null || "$IPT" -A INPUT -i lo -j ACCEPT
"$IPT" -C INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
"$IPT" -C INPUT -p ipv6-icmp --icmpv6-type echo-request -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -p ipv6-icmp --icmpv6-type echo-request -j ACCEPT
"$IPT" -C INPUT -p ipv6-icmp --icmpv6-type destination-unreachable -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -p ipv6-icmp --icmpv6-type destination-unreachable -j ACCEPT
"$IPT" -C INPUT -p ipv6-icmp --icmpv6-type packet-too-big -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -p ipv6-icmp --icmpv6-type packet-too-big -j ACCEPT
"$IPT" -C INPUT -p ipv6-icmp --icmpv6-type time-exceeded -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -p ipv6-icmp --icmpv6-type time-exceeded -j ACCEPT
"$IPT" -C INPUT -p ipv6-icmp --icmpv6-type neighbor-solicitation -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -p ipv6-icmp --icmpv6-type neighbor-solicitation -j ACCEPT
"$IPT" -C INPUT -p ipv6-icmp --icmpv6-type neighbor-advertisement -j ACCEPT 2>/dev/null \
  || "$IPT" -A INPUT -p ipv6-icmp --icmpv6-type neighbor-advertisement -j ACCEPT

/usr/sbin/ip6tables-restore -n "$FRAGMENT"
"$IPT" -C INPUT -m comment --comment "$COMMENT" -j "$CHAIN" 2>/dev/null \
  || "$IPT" -A INPUT -m comment --comment "$COMMENT" -j "$CHAIN"

"$IPT" -P INPUT DROP
"$IPT" -P FORWARD DROP
"$IPT" -P OUTPUT ACCEPT
